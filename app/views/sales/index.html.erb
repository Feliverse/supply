<div class="container-fluid">
  <div class="row justify-content-center">
    <div class="col-md-12">
      <%= render 'nav' %>
    </div>
    <main class="col-md-9 ml-sm-auto col-lg-10 px-md-4 mt-md-5" style="background: rgba(255, 255, 255, 0.6); border-radius: 1rem;">
      <h1 class="text-center mt-md-2"><%= @almacen.name %> - Ventas</h1>
      <h2>Lista de Ventas</h2>
      <table class="table table-striped">
        <thead>
          <tr>
            <th>ID</th>
            <th>Cliente</th>
            <th>Fecha</th>
            <th>Total</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% @sales.each do |sale| %>
            <tr>
              <td><%= sale.id %></td>
                <td><%= sale.cliente.name %></td>
                <td><%= sale.fecha.in_time_zone('La Paz').strftime('%d-%m-%Y  %H:%M') %></td>
              <td><%= number_to_currency(sale.total) %></td>
              <td>
                <%= link_to almacen_sale_path(@almacen, sale), class: 'btn btn-primary btn-sm', title: 'Ver' do %>
                  <i class="fas fa-eye"></i>
                <% end %>
                <%= link_to edit_almacen_sale_path(@almacen, sale), class: 'btn btn-secondary btn-sm', title: 'Editar' do %>
                  <i class="fas fa-edit"></i>
                <% end %>
                <%= link_to almacen_sale_path(@almacen, sale), method: :delete, data: { confirm: '¿Estás seguro?' }, class: 'btn btn-danger btn-sm', title: 'Eliminar' do %>
                  <i class="fas fa-trash-alt"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= link_to 'Nueva Venta', new_almacen_sale_path(@almacen), class: 'btn btn-success mb-2' %>
    </main>
  </div>
</div>