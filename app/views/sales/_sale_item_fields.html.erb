<div class="nested-fields">
  <div class="field">
    <%= f.label :inventario_id %>
    <%= f.collection_select :inventario_id, Inventario.all, :id, :id, include_blank: true, data: { available_quantity: :cantidad_disponible } %>
    <span class="available_quantity"></span>
  </div>

  <div class="field">
    <%= f.label :cantidad %>
    <%= f.number_field :cantidad %>
  </div>

  <div class="field">
    <%= f.label :unidad_de_medida %>
    <%= f.text_field :unidad_de_medida %>
  </div>

  <div class="field">
    <%= f.label :precio_unitario %>
    <%= f.number_field :precio_unitario, step: 0.01 %>
  </div>

  <%= link_to 'Remove Item', '#', class: 'remove_item' %>
</div>
