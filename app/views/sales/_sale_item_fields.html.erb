<div class="nested-fields">
  <table class="table table-bordered">
    <thead class="thead-light">
      <tr>
        <th>Producto</th>
        <th>Cantidad</th>
        <th>Unidad de Medida</th>
        <th>Precio Unitario</th>
        <th>Total</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody id="sale-items-table">
      <tr>
        <td>
          <%= f.select :inventario_id, grouped_options_for_select(Inventario.all.group_by(&:almacen).map { |almacen, inventarios| [almacen.name, inventarios.map { |inventario| [inventario.name_with_quantity, inventario.id] }] }), { include_blank: true }, class: 'form-control' %>
          <span class="available_quantity text-muted"></span>
        </td>
        <td>
          <%= f.number_field :cantidad, class: 'form-control cantidad_field' %>
        </td>
        <td>
          <%= f.text_field :unidad_de_medida, class: 'form-control' %>
        </td>
        <td>
          <%= f.number_field :precio_unitario, step: 0.01, class: 'form-control precio_unitario_field' %>
        </td>
        <td>
          <span class="total_parcial text-muted">0.00</span>
        </td>
        <td>
          <%= link_to '#', class: 'remove_item' do %>
            <i class="fas fa-trash-alt text-danger"></i>
          <% end %>
        </td>
      </tr>
    </tbody>
  </table>
</div>

<div class="mt-3 text-right">
  <%= link_to 'Agregar Producto', '#', class: 'btn btn-primary add_item' %>
</div>

<div class="mt-3">
  <strong>Total General: </strong><span id="total_general" class="text-muted"></span>
</div>

<script>
  function calculateTotalParcial() {
    document.querySelectorAll('.nested-fields tbody tr').forEach(function(row) {
      var cantidad = parseFloat(row.querySelector('.cantidad_field').value) || 0;
      var precioUnitario = parseFloat(row.querySelector('.precio_unitario_field').value) || 0;
      var totalParcial = cantidad * precioUnitario;
      row.querySelector('.total_parcial').innerText = totalParcial.toFixed(2);
    });
    calculateTotalGeneral();
  }

  function calculateTotalGeneral() {
    var totalGeneral = 0;
    document.querySelectorAll('.total_parcial').forEach(function(totalParcial) {
      totalGeneral += parseFloat(totalParcial.innerText) || 0;
    });
    document.getElementById('total_general').innerText = totalGeneral.toFixed(2);
  }

  document.addEventListener('input', function(event) {
    if (event.target.classList.contains('cantidad_field') || event.target.classList.contains('precio_unitario_field')) {
      calculateTotalParcial();
    }
  });

  document.addEventListener('DOMContentLoaded', function() {
    calculateTotalParcial();
  });

  document.querySelector('.add_item').addEventListener('click', function(event) {
    event.preventDefault();
    var newRow = document.querySelector('.nested-fields tbody tr').cloneNode(true);
    newRow.querySelectorAll('input').forEach(function(input) {
      input.value = '';
    });
    newRow.querySelector('.total_parcial').innerText = '0.00';
    document.getElementById('sale-items-table').appendChild(newRow);
  });

  document.getElementById('sale-items-table').addEventListener('input', function(event) {
    if (event.target.classList.contains('cantidad_field') || event.target.classList.contains('precio_unitario_field')) {
      calculateTotalParcial();
    }
  });
</script>
